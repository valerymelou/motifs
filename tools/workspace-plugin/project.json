{
  "name": "workspace-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/workspace-plugin/src",
  "projectType": "library",
  "tags": ["type:tooling"],
  "targets": {
    "assemble-site": {
      "executor": "@motifs/workspace-plugin:assemble-site",
      "dependsOn": [
        {
          "target": "build",
          "projects": ["motifs", "tag:type:landing"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/site"]
    },
    "lighthouse": {
      "executor": "nx:run-commands",
      "dependsOn": ["assemble-site"],
      "options": {
        "command": "lhci autorun"
      },
      "outputs": ["{workspaceRoot}/.lighthouseci"]
    }
  }
}
