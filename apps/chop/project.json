{
  "name": "chop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "mt",
  "sourceRoot": "apps/chop/src",
  "tags": ["type:landing"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/chop",
          "browser": "chop"
        },
        "browser": "apps/chop/src/main.ts",
        "tsConfig": "apps/chop/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/chop/public"
          }
        ],
        "styles": ["apps/chop/src/theme.css"],
        "server": "apps/chop/src/main.server.ts",
        "outputMode": "static",
        "security": {
          "allowedHosts": []
        },
        "baseHref": "/chop/"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4303
      },
      "configurations": {
        "production": {
          "buildTarget": "chop:build:production"
        },
        "development": {
          "buildTarget": "chop:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "chop:build",
        "port": 4303,
        "staticFilePath": "dist/apps/chop",
        "spa": false
      }
    },
    "og": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --no-warnings apps/chop/og/render-og.mts apps/chop/public/og.png"
      },
      "inputs": [
        "{projectRoot}/og/**",
        "{projectRoot}/src/app/content.ts",
        "{projectRoot}/src/app/circle/circle.ts"
      ],
      "outputs": ["{projectRoot}/public/og.png"],
      "cache": true
    }
  }
}
