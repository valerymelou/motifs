{
  "name": "bamboutos-coffee",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "mt",
  "sourceRoot": "apps/bamboutos-coffee/src",
  "tags": ["type:landing"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/bamboutos-coffee",
          "browser": "bamboutos-coffee"
        },
        "browser": "apps/bamboutos-coffee/src/main.ts",
        "tsConfig": "apps/bamboutos-coffee/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/bamboutos-coffee/public"
          },
          {
            "glob": "big-shoulders-display-latin-wght-normal.woff2",
            "input": "node_modules/@fontsource-variable/big-shoulders-display/files",
            "output": "fonts"
          }
        ],
        "styles": ["apps/bamboutos-coffee/src/theme.css"],
        "server": "apps/bamboutos-coffee/src/main.server.ts",
        "outputMode": "static",
        "security": {
          "allowedHosts": []
        },
        "baseHref": "/bamboutos-coffee/"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4304
      },
      "configurations": {
        "production": {
          "buildTarget": "bamboutos-coffee:build:production"
        },
        "development": {
          "buildTarget": "bamboutos-coffee:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "bamboutos-coffee:build",
        "port": 4304,
        "staticFilePath": "dist/apps/bamboutos-coffee",
        "spa": false
      }
    },
    "images": {
      "executor": "@motifs/workspace-plugin:optimize-images",
      "options": {
        "input": "apps/bamboutos-coffee/images-src",
        "output": "apps/bamboutos-coffee/public/images",
        "manifest": "apps/bamboutos-coffee/src/app/photos/manifest.ts",
        "exclude": ["rim-dawn-phone"],
        "crops": [
          {
            "name": "rim-dawn-tall",
            "from": "rim-dawn-phone",
            "aspect": 0.8,
            "focusX": 0.6,
            "widths": [480, 768, 1080],
            "blur": 0.8
          },
          {
            "name": "plate-beds",
            "from": "parchment-beds",
            "aspect": 1.3333333333333333,
            "focusX": 0.55,
            "widths": [480, 768, 1080, 1440]
          },
          {
            "name": "plate-roast",
            "from": "roast-cooling",
            "aspect": 1.3333333333333333,
            "focusX": 0.5,
            "widths": [480, 768, 1080, 1440]
          }
        ]
      },
      "inputs": ["{projectRoot}/images-src/**/*"],
      "outputs": [
        "{projectRoot}/public/images",
        "{projectRoot}/src/app/photos/manifest.ts"
      ],
      "cache": true
    },
    "og": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --no-warnings apps/bamboutos-coffee/og/render-og.mts apps/bamboutos-coffee/public/og.png"
      },
      "inputs": [
        "{projectRoot}/og/**",
        "{projectRoot}/images-src/rim-dawn.jpeg",
        "{projectRoot}/src/app/content.ts"
      ],
      "outputs": ["{projectRoot}/public/og.png"],
      "cache": true
    }
  }
}
