{
  "name": "motifs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "mt",
  "sourceRoot": "apps/motifs/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/motifs",
        "browser": "apps/motifs/src/main.ts",
        "tsConfig": "apps/motifs/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/motifs/public"
          },
          {
            "glob": "instrument-serif-latin-400-{normal,italic}.woff2",
            "input": "node_modules/@fontsource/instrument-serif/files",
            "output": "fonts"
          }
        ],
        "styles": ["apps/motifs/src/theme.css"],
        "server": "apps/motifs/src/main.server.ts",
        "outputMode": "static",
        "security": {
          "allowedHosts": []
        },
        "index": {
          "input": "apps/motifs/src/index.html",
          "preloadInitial": false
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "motifs:build:production"
        },
        "development": {
          "buildTarget": "motifs:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "setupFiles": ["apps/motifs/src/test-setup.ts"]
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "motifs:build",
        "staticFilePath": "dist/apps/motifs/browser",
        "spa": false
      }
    },
    "og": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --no-warnings apps/motifs/og/render-og.mts apps/motifs/public/og.png"
      },
      "inputs": [
        "{projectRoot}/og/**",
        "{projectRoot}/src/app/motifs/**",
        "{workspaceRoot}/libs/pages-manifest/src/**"
      ],
      "outputs": ["{projectRoot}/public/og.png"],
      "cache": true
    }
  }
}
